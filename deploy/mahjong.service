[Unit]
Description=Mahjong Online Server (WebSocket + Static)
After=network.target

[Service]
Type=simple
# 改成你的实际部署路径
WorkingDirectory=/opt/mahjong-game
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
# 端口可用环境变量覆盖（nginx 反代时建议只监听本机）
Environment=PORT=3000
Environment=NODE_ENV=production

# 安全加固（可选）
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
